# BEGIN WordPress and Static Site

# Custom Error Documents
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
    # Disable Etags
    Header unset ETag
    FileETag None

    # Force revalidation for all content (Aggressive Cache Busting)
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
Options +FollowSymLinks -MultiViews -Indexes

# FORCE UPDATE: 2026-01-09 v5

# 1. Passthrough for WordPress Core & API
# Prioritize these to ensure WordPress administration and API always work
RewriteRule ^index\.php$ - [L]
RewriteRule ^wp-admin - [L]
RewriteRule ^wp-content - [L]
RewriteRule ^wp-includes - [L]
RewriteRule ^wp-login\.php - [L]

# 2. WordPress API - hand off to WordPress for virtual URLs
RewriteRule ^wp-json(/.*)?$ /index.php [L]

# 3. Root Handling
RewriteRule ^$ index.html [L]

# 4. Clean URLs (Extensionless -> .html)
# Prioritize .html files over directories with the same name
RewriteCond %{REQUEST_URI} !^/wp-
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 5. Static Files & Assets - serve directly if they exist
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 6. Custom 404 Handler - serve Next.js 404 page for all other requests
# This prevents showing the WordPress UI for invalid routes
RewriteRule ^ /404.html [L]
</IfModule>
# END WordPress and Static Site
